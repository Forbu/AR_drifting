# CHAMPION (technique): randsigma random-pixel-noise context aug (SCALE=0.1, last-frame-only).
# Wins cross-seed at moderate compute (4500/220): S0 875<951, S2 947<1242 (-24%, cures
# blur+mass-drift). avg 911 vs none 1097 (-17%). REGIME-DEPENDENT robustness mechanism:
# tax on lucky seed at HIGH compute (none@6000/500 SEED=0=634 is the absolute best metric,
# but seed-lucky & SEED=2 still fails there); CURE wherever the base model is drift-prone.
# Keep ~15 epochs when scaling (6000/500 sweet spot for base; bigger data needs prop. compute).
ARCH=jit3d
N_TRAJ_TRAIN=220
TRAJ_LEN=80
K_CTX=2
C_CHAN=1
IMG=32
JIT_EMBED_DIM=128
JIT_DEPTH=4
JIT_HEADS=4
JIT_PATCH_T=1
JIT_PATCH_HW=8
JIT_CORRUPT_PROB=0.0
NOISE_INJECT=0.0
SAMPLE_AVG=4
LR=1e-4
GRAD_CLIP=1.0
WARMUP_STEPS=0
AMP=0
RF_WCLAMP=6
TRAIN_STEPS=4500
SEED=0
LORENZ_DT=0.024
ODE_STEPS=32
BATCH=96
FLOW=bridge
BRIDGE_LOSS=vloss
BRIDGE_SIGMA=0.3
BRIDGE_SIGMA_MIN=0.001
BRIDGE_WCLAMP=10
TECHNIQUE=ctx_bridge
CTX_BRIDGE_SIGMA=0.3
CTX_BRIDGE_SIGMA_MIN=0.001
CTX_BRIDGE_SCALE=0.1
CTX_BRIDGE_TIME=randsigma
CTX_BRIDGE_LAST_ONLY=1
CTX_BRIDGE_ANNEAL=0.0
