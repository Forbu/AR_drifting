# EXP 1: joint RF-context-gen + bridge-future-pred (user defaults).
# context time s=min(1,t+0.3) (leads toward data), both [s,t] passed to net,
# ctx weight 1.0, all K context slots RF-noised.
ARCH=jit3d
N_TRAJ_TRAIN=220
TRAJ_LEN=80
K_CTX=2
C_CHAN=1
IMG=32
JIT_EMBED_DIM=128
JIT_DEPTH=4
JIT_HEADS=4
JIT_PATCH_T=1
JIT_PATCH_HW=8
JIT_CORRUPT_PROB=0.0
NOISE_INJECT=0.0
SAMPLE_AVG=4
LR=1e-4
GRAD_CLIP=1.0
WARMUP_STEPS=0
AMP=0
RF_WCLAMP=6
TRAIN_STEPS=4500
SEED=0
LORENZ_DT=0.024
ODE_STEPS=32
BATCH=96
FLOW=bridge
BRIDGE_LOSS=vloss
BRIDGE_SIGMA=0.3
BRIDGE_SIGMA_MIN=0.001
BRIDGE_WCLAMP=10
TECHNIQUE=none
# --- joint-gen knobs ---
JOINT_GEN=1
JOINT_CTX_WEIGHT=0.5
JOINT_COUPLE=1
JOINT_LEAD=0.5
JOINT_CTX_TMIN=0.0
JOINT_DECOUPLE=1
JOINT_LAST_ONLY=1
