# EXP: GRADED per-frame bridge context (user idea), decouple=0. newest noisiest -> oldest cleanest.
ARCH=jit3d
N_TRAJ_TRAIN=220
TRAJ_LEN=80
K_CTX=2
C_CHAN=1
IMG=32
JIT_EMBED_DIM=128
JIT_DEPTH=4
JIT_HEADS=4
JIT_PATCH_T=1
JIT_PATCH_HW=8
JIT_CORRUPT_PROB=0.0
NOISE_INJECT=0.0
SAMPLE_AVG=4
LR=1e-4
GRAD_CLIP=1.0
WARMUP_STEPS=0
AMP=0
RF_WCLAMP=6
TRAIN_STEPS=4500
SEED=0
LORENZ_DT=0.024
ODE_STEPS=32
BATCH=96
FLOW=bridge
BRIDGE_LOSS=vloss
BRIDGE_SIGMA=0.3
BRIDGE_SIGMA_MIN=0.001
BRIDGE_WCLAMP=10
TECHNIQUE=none
# --- joint-gen: graded per-frame bridge context, decouple=0 (user idea) ---
JOINT_GEN=1
JOINT_CTX_FLOW=bridge
JOINT_CTX_BRIDGE_SIGMA=0.1
JOINT_CTX_BRIDGE_SIGMA_MIN=0.001
JOINT_GRADED=0
JOINT_LEAD=0.5
JOINT_LEAD_STEP=0.3
JOINT_COUPLE=1
JOINT_DECOUPLE=0
JOINT_CTX_WEIGHT=1.0
JOINT_LAST_ONLY=1
