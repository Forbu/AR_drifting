# Video rollout: JiT-3D + Brownian-bridge. randsigma (random pixel-noise sigma)
# context aug + LONGER training (6000) + BIGGER dataset (500 traj).
ARCH=jit3d
N_TRAJ_TRAIN=500
TRAJ_LEN=80
K_CTX=2
C_CHAN=1
IMG=32
JIT_EMBED_DIM=128
JIT_DEPTH=4
JIT_HEADS=4
JIT_PATCH_T=1
JIT_PATCH_HW=8
JIT_CORRUPT_PROB=0.0
NOISE_INJECT=0.0
SAMPLE_AVG=4
LR=1e-4
GRAD_CLIP=1.0
WARMUP_STEPS=0
AMP=0
RF_WCLAMP=6
TRAIN_STEPS=6000
SEED=0
LORENZ_DT=0.024
ODE_STEPS=32
BATCH=96
FLOW=bridge
BRIDGE_LOSS=vloss
BRIDGE_SIGMA=0.3
BRIDGE_SIGMA_MIN=0.001
BRIDGE_WCLAMP=10
TECHNIQUE=ctx_bridge
CTX_BRIDGE_SIGMA=0.3
CTX_BRIDGE_SIGMA_MIN=0.001
CTX_BRIDGE_SCALE=0.1
CTX_BRIDGE_TIME=randsigma
CTX_BRIDGE_LAST_ONLY=1
CTX_BRIDGE_ANNEAL=0.0
