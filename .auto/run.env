# CHAMPION: ctx_bridge (Gaussian/Brownian-bridge context augmentation) @ drift regime
# Active ingredient = Gaussian noise MAGNITUDE (std~0.06) on the last context frame.
# Bridge schedule (sample mode) is comparable (within seed noise); flat/uniform is
# simplest + most robust on mass. Helps ONLY where AR drift exists (dt=0.024);
# neutral at dt=0.012. Decoupled (clean context) at inference.
TECHNIQUE=ctx_bridge
ARCH=jit3d
N_TRAJ_TRAIN=220
K_CTX=2
JIT_EMBED_DIM=128
JIT_DEPTH=4
JIT_HEADS=4
JIT_PATCH_T=1
JIT_PATCH_HW=8
JIT_CORRUPT_PROB=0.0
NOISE_INJECT=0.0
SAMPLE_AVG=4
LR=1e-4
GRAD_CLIP=1.0
WARMUP_STEPS=0
AMP=0
RF_WCLAMP=6
TRAIN_STEPS=4500
SEED=0
LORENZ_DT=0.024
ODE_STEPS=32
FLOW=bridge
BRIDGE_LOSS=vloss
BRIDGE_SIGMA=0.3
BRIDGE_SIGMA_MIN=0.001
BRIDGE_WCLAMP=10
CTX_BRIDGE_SIGMA=0.3
CTX_BRIDGE_SIGMA_MIN=0.001
CTX_BRIDGE_SCALE=0.2
CTX_BRIDGE_TIME=uniform
CTX_BRIDGE_LAST_ONLY=1
