# Video rollout: SELF-FEED with CHEAP surrogate (8 ODE steps) - feasible on ViT now.
# selffeed_m @4500/220 SEED=2 (collapsing seed). Does scheduled sampling cure the collapse?
ARCH=jit3d
N_TRAJ_TRAIN=220
TRAJ_LEN=80
K_CTX=2
C_CHAN=1
IMG=32
JIT_EMBED_DIM=128
JIT_DEPTH=4
JIT_HEADS=4
JIT_PATCH_T=1
JIT_PATCH_HW=8
JIT_CORRUPT_PROB=0.0
NOISE_INJECT=0.0
SAMPLE_AVG=4
LR=1e-4
GRAD_CLIP=1.0
WARMUP_STEPS=0
AMP=0
RF_WCLAMP=6
TRAIN_STEPS=4500
SEED=2
LORENZ_DT=0.024
ODE_STEPS=32
BATCH=96
FLOW=bridge
BRIDGE_LOSS=vloss
BRIDGE_SIGMA=0.3
BRIDGE_SIGMA_MIN=0.001
BRIDGE_WCLAMP=10
TECHNIQUE=selffeed_m
SELFFEED_PROB=0.3
SELFFEED_ODE_STEPS=8
MANIFOLD_JITTER=0.08
